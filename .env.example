# Copia este archivo como .env.local para desarrollo. Nunca subas .env.local a git.
# En Vercel estas variables ya las puso la integración de Supabase.

# Postgres de Supabase (pooler en modo transacción, puerto 6543)
POSTGRES_URL=
# Postgres de Supabase (pooler en modo sesión, puerto 5432) — lo usan las migraciones
POSTGRES_URL_NON_POOLING=
# Secreto del servidor para firmar sesiones y partidas (en Vercel se usa SUPABASE_JWT_SECRET)
SESSION_SECRET=
# URL pública de la app (para enlaces de invitación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Higgsfield API (solo servidor/scripts). Formato: key-id:key-secret
HF_CREDENTIALS=
